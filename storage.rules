rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && 'admin' in request.auth.token
        && request.auth.token.admin == true;
    }

    function isAllowedCmsUpload() {
      return request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches(
          'image/jpeg|image/png|image/webp|image/gif|application/pdf'
        );
    }

    match /business-cards/{userId}/{fileName} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create: if signedIn() && request.auth.uid == userId
        && resource == null
        && request.resource.size > 0
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches(
          'image/jpeg|image/png|image/webp|image/gif|application/pdf'
        );
      allow update, delete: if false;
    }

    match /cms/published/{assetId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /cms/drafts/{assetId}/{fileName} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isAllowedCmsUpload();
      allow update, delete: if false;
    }

    match /consult-attachments/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
