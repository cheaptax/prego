# Copy this file to `.env.local` and fill in values.
# Firebase Console > Project settings > General (client config)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Console > Project settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Admin Auth bootstrap (email only in tracked files)
# ADMIN_PASSWORD must NOT be committed. Set it in the shell for seed:admin apply.
# See docs/ADMIN_AUTH_MIGRATION.md
ADMIN_EMAIL=admin@gmail.com
# Optional: required by seed/check scripts unless passed as --expected-project
# ADMIN_SEED_EXPECTED_PROJECT_ID=

# 둥기농협 demo master and signup (server only)
# Signup defaults to enabled outside production and disabled in production.
DEMO_COOPERATIVE_SIGNUP_ENABLED=false
# Optional: required by seed unless passed as --expected-project.
# DEMO_COOPERATIVE_SEED_EXPECTED_PROJECT_ID=
# Production seed apply requires this flag plus an exact confirmation argument.
DEMO_COOPERATIVE_SEED_PRODUCTION_ENABLED=false

# Read-only test data graph scan. Production CLI scans additionally require
# --confirm-production <institution-id>. This flag never enables deletion.
TEST_DATA_SCAN_PRODUCTION_ENABLED=false
# Manifest-based Firestore purge APPLY. Keep disabled unless running the
# dedicated server API against an explicitly allowed project.
TEST_DATA_PURGE_ENABLED=false
TEST_DATA_PURGE_ALLOWED_PROJECT_ID=
# Separate STEP 6 gate for Firebase Auth disable/revoke/delete and exact-path
# Storage deletion. Keep false in production unless the approved purge run
# explicitly includes external resources.
TEST_DATA_PURGE_EXTERNAL_ENABLED=false
# Additional production gate. STEP 6 verification must not enable this.
TEST_DATA_PURGE_PRODUCTION_ENABLED=false

# FY27 audit-quote intake (server only; never expose to the client)
# HMAC pepper for emailHash / idempotency hashes (min 16 chars)
AUDIT_QUOTE_HASH_PEPPER=
# Optional dedicated HMAC secret for one-time temporary-member activation
# links. Falls back to AUDIT_QUOTE_HASH_PEPPER when omitted.
TEMPORARY_MEMBER_TOKEN_SECRET=
# Feature flag: true|false (default false — must enable explicitly per environment)
AUDIT_QUOTE_EVENT_ENABLED=true
# Must match the consent version sent by the client
AUDIT_QUOTE_PRIVACY_POLICY_VERSION=2026-07-20
# Comma-separated browser origins allowed to call the API
AUDIT_QUOTE_ALLOWED_ORIGINS=http://localhost:3000,https://project-eta-one-64.vercel.app
# Optional allowlists / limits
AUDIT_QUOTE_ALLOWED_CAMPAIGNS=fy27-audit-quote
AUDIT_QUOTE_ALLOWED_CHANNELS=event_page,direct,share
AUDIT_QUOTE_MAX_BODY_BYTES=8192
# Optional bot-protection boundaries (adapters not configured by default)
AUDIT_QUOTE_CAPTCHA_ENABLED=false
AUDIT_QUOTE_APP_CHECK_ENABLED=false
# Event page policy flags (no secrets)
AUDIT_QUOTE_ENDS_AT=
AUDIT_QUOTE_CLOSED_MESSAGE=
AUDIT_QUOTE_PRIVACY_POLICY_HREF=/signup
AUDIT_QUOTE_RETENTION_COPY=
AUDIT_QUOTE_GUARANTEE_MIN_QUOTES=false
AUDIT_QUOTE_SHOW_POINTS_BENEFIT=false
AUDIT_QUOTE_POINTS_BASE_LABEL=
# Staff notification (generic webhook; Slack incoming webhook compatible)
AUDIT_QUOTE_NOTIFY_WEBHOOK_URL=
# Optional: include raw email in webhook body (default false). Never put email in title.
AUDIT_QUOTE_NOTIFY_INCLUDE_EMAIL=false
AUDIT_QUOTE_ADMIN_BASE_URL=http://localhost:3000

# Transactional email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL="농협지원센터 <no-reply@example.com>"
RESEND_WEBHOOK_SECRET=
NH_SUPPORT_BASE_URL=http://localhost:3000
# HMAC pepper for public partner-application rate-limit keys (min 16 chars)
PARTNER_APPLICATION_HASH_PEPPER=

# Audit evaluation domain feature flags (server only; default false)
AUDIT_EVALUATION_ENABLED=false
AUDIT_EVALUATION_CUSTOMER_ENTRY_ENABLED=false
AUDIT_EVALUATION_REPORT_DOWNLOAD_ENABLED=false
AUDIT_EVALUATION_ADMIN_ENABLED=false
AUDIT_EVALUATION_AI_NARRATIVE_ENABLED=false
# Active published evaluation config ID. Set before customer entry rollout.
AUDIT_EVALUATION_ACTIVE_CONFIG_ID=
# Server-only HMAC secret for standard quote identities (minimum 32 bytes)
AUDIT_EVALUATION_DOCUMENT_SIGNING_SECRET=
# Separate server-only HMAC secret for access/session tokens (minimum 32 bytes)
AUDIT_EVALUATION_ACCESS_SECRET=
# "local" is development-only. Production may use the existing Resend
# configuration ("resend") or an authenticated HTTPS "webhook" adapter.
AUDIT_EVALUATION_EMAIL_PROVIDER=
AUDIT_EVALUATION_EMAIL_WEBHOOK_URL=
AUDIT_EVALUATION_EMAIL_WEBHOOK_TOKEN=
# Optional staged-rollout gate: comma-separated HMAC-SHA256 email hashes.
# Empty means no additional allowlist after the customer-entry flag is enabled.
AUDIT_EVALUATION_ACCESS_EMAIL_HASH_ALLOWLIST=
AUDIT_EVALUATION_BASE_URL=http://localhost:3000
# PDF security scanning. "static" is a limited built-in risk scan; use
# "required" with an HTTPS AV/CDR service before full public rollout.
AUDIT_EVALUATION_AV_SCAN_MODE=static
AUDIT_EVALUATION_AV_SCAN_URL=
AUDIT_EVALUATION_AV_SCAN_TOKEN=
# Vercel Cron bearer secret for the server-only retention endpoint
CRON_SECRET=
