rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && 'admin' in request.auth.token
        && request.auth.token.admin == true;
    }

    // Public CMS documents contain rendered content only. All CMS writes are
    // performed by trusted server code through the Admin SDK.
    match /cmsPublishedPages/{pageKey} {
      allow read: if true;
      allow write: if false;
    }

    match /cmsPublishedGlobals/{documentKey} {
      allow read: if true;
      allow write: if false;
    }

    match /cmsDraftPages/{pageKey} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /cmsDraftGlobals/{documentKey} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /cmsPageRevisions/{pageKey} {
      allow read, write: if false;

      match /revisions/{revisionId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    match /cmsGlobalRevisions/{documentKey} {
      allow read, write: if false;

      match /revisions/{revisionId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    match /cmsAuditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /cmsAssets/{assetId} {
      // Public pages receive resolved asset URLs from trusted server rendering.
      // Keep uploader IDs and draft lifecycle metadata admin-only.
      allow read: if isAdmin();
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, update, delete: if false;
    }

    match /organizations/{organizationId} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    match /pointLedger/{ledgerId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /consultRequests/{requestId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Audit-quote intake is server/Admin SDK only. Deny all client access.
    match /auditQuoteRequests/{requestId} {
      allow read, write: if false;
    }
    match /auditQuoteIdempotency/{keyHash} {
      allow read, write: if false;
    }
    match /auditQuoteEmailDedup/{dedupId} {
      allow read, write: if false;
    }
    match /auditQuoteRateLimits/{limitId} {
      allow read, write: if false;
    }
    match /auditQuoteNotifications/{requestId} {
      allow read, write: if false;
    }
  }
}
