rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isActiveAccount(user) {
      return (
        'accountStatus' in user
        && user.accountStatus == 'active'
      ) || (
        !('accountStatus' in user)
        && user.status == 'active'
      );
    }

    function isAdmin() {
      return signedIn()
        && 'admin' in request.auth.token
        && request.auth.token.admin == true
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.role == 'admin'
        && isActiveAccount(
          firestore.get(
            /databases/(default)/documents/users/$(request.auth.uid)
          ).data
        );
    }

    function isAllowedCmsUpload() {
      return request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches(
          'image/jpeg|image/png|image/webp|image/gif|application/pdf'
        );
    }

    match /business-cards/{userId}/{fileName} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create: if signedIn() && request.auth.uid == userId
        && resource == null
        && request.resource.size > 0
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches(
          'image/jpeg|image/png|image/webp|image/gif|application/pdf'
        );
      allow update, delete: if false;
    }

    match /cms/published/{assetId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /cms/drafts/{assetId}/{fileName} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isAllowedCmsUpload();
      allow update, delete: if false;
    }

    match /consult-attachments/{allPaths=**} {
      // Partner attachment delivery must go through an assignment-authorized
      // server endpoint or signed URL. Storage paths alone do not prove scope.
      allow read: if isAdmin();
      allow write: if false;
    }

    match /partner-assets/{allPaths=**} {
      allow read, write: if false;
    }

    match /quotes/{allPaths=**} {
      allow read, write: if false;
    }

    // Audit evaluation files are accessed only through server-authorized
    // short-lived URLs. Firebase client credentials never grant access.
    match /audit-evaluation/originals/{allPaths=**} {
      allow read, write: if false;
    }

    match /audit-evaluation/quarantine/{allPaths=**} {
      allow read, write: if false;
    }

    match /audit-evaluation/reports/{allPaths=**} {
      allow read, write: if false;
    }

    match /audit-evaluation/temp/{allPaths=**} {
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
