# Copy this file to `.env.local` and fill in values.
# Firebase Console > Project settings > General (client config)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Console > Project settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Admin console login (defaults shown; change in production)
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin

# FY27 audit-quote intake (server only; never expose to the client)
# HMAC pepper for emailHash / idempotency hashes (min 16 chars)
AUDIT_QUOTE_HASH_PEPPER=
# Feature flag: true|false (default false — must enable explicitly per environment)
AUDIT_QUOTE_EVENT_ENABLED=true
# Must match the consent version sent by the client
AUDIT_QUOTE_PRIVACY_POLICY_VERSION=2026-07-20
# Comma-separated browser origins allowed to call the API
AUDIT_QUOTE_ALLOWED_ORIGINS=http://localhost:3000,https://project-eta-one-64.vercel.app
# Optional allowlists / limits
AUDIT_QUOTE_ALLOWED_CAMPAIGNS=fy27-audit-quote
AUDIT_QUOTE_ALLOWED_CHANNELS=event_page,direct,share
AUDIT_QUOTE_MAX_BODY_BYTES=8192
# Optional bot-protection boundaries (adapters not configured by default)
AUDIT_QUOTE_CAPTCHA_ENABLED=false
AUDIT_QUOTE_APP_CHECK_ENABLED=false
# Event page policy flags (no secrets)
AUDIT_QUOTE_ENDS_AT=
AUDIT_QUOTE_CLOSED_MESSAGE=
AUDIT_QUOTE_PRIVACY_POLICY_HREF=/signup
AUDIT_QUOTE_RETENTION_COPY=
AUDIT_QUOTE_GUARANTEE_MIN_QUOTES=false
AUDIT_QUOTE_SHOW_POINTS_BENEFIT=false
AUDIT_QUOTE_POINTS_BASE_LABEL=
# Staff notification (generic webhook; Slack incoming webhook compatible)
AUDIT_QUOTE_NOTIFY_WEBHOOK_URL=
# Optional: include raw email in webhook body (default false). Never put email in title.
AUDIT_QUOTE_NOTIFY_INCLUDE_EMAIL=false
AUDIT_QUOTE_ADMIN_BASE_URL=http://localhost:3000
